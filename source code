// ============================================================
// SEWER CLEANING ROBOT - ESP32 WEB CONTROLLER  (v2)
// Works on Arduino-ESP32 core 2.x AND 3.x (PWM shim below).
// No ESP32Servo library needed: the servo uses LEDC directly.
// The web page is fully self-contained (no internet / CDN needed,
// because the ESP32 is its own WiFi access point).
// ============================================================

const char*   WIFI_SSID        = "Robot_Control";
const char*   WIFI_PASSWORD    = "12345678";   // CHANGE THIS before real use (min 8 chars)
const uint8_t WIFI_CHANNEL     = 1;
const uint8_t WIFI_MAX_CLIENTS = 2;            // fewer clients = more responsive control

WebServer server(80);

// ============================================================
// TYPES
// ============================================================
enum DriveState    { DRIVE_STOP, DRIVE_FORWARD, DRIVE_BACKWARD, DRIVE_LEFT, DRIVE_RIGHT,
                     DRIVE_SPIN_LEFT, DRIVE_SPIN_RIGHT };   // spins are used by auto mode
enum ConveyorState { CONV_STOP, CONV_FORWARD, CONV_REVERSE };
enum AutoState     { AUTO_SCAN, AUTO_ALIGN, AUTO_APPROACH, AUTO_COLLECT, AUTO_BACKUP };

// ============================================================
// PINS
// Strapping-pin notes (rewire if you ever see boot problems):
//   GPIO 12 (TRIG) : must be LOW at boot or the ESP32 may fail to start.
//   GPIO 15        : pulled HIGH at boot silences the boot log.
//   GPIO 5, 14, 15 : output a short PWM burst during boot (motor twitch / buzzer chirp).
// Fitting a 10k pull-down on each motor driver input removes boot twitching.
// ============================================================
const uint8_t SERVO_PIN  = 21;
const uint8_t BUZZER_PIN = 14;
const uint8_t TRIG_PIN   = 12;
const uint8_t ECHO_PIN   = 13;   // HC-SR04 echo is 5V: use a 1k/2k voltage divider!
const uint8_t LDR_PIN    = 34;   // ADC1 (works with WiFi on), input-only

// ============================================================
// PWM SHIM (core 2.x uses channels, core 3.x uses pins)
//   channels 0-7 -> motors (5 kHz, 8 bit)   [high-speed group]
//   channel  8   -> servo  (50 Hz, 14 bit)  [low-speed group]
// ============================================================
void pwmAttach(uint8_t pin, uint8_t ch, uint32_t freq, uint8_t bits)
{
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
    ledcAttachChannel(pin, freq, bits, ch);
#else
    ledcSetup(ch, freq, bits);
    ledcAttachPin(pin, ch);
#endif
}

void pwmWrite(uint8_t pin, uint8_t ch, uint32_t duty)
{
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
    ledcWrite(pin, duty);
#else
    ledcWrite(ch, duty);
#endif
}

// ============================================================
// MOTORS
// ============================================================
const uint8_t  BASE_PWM        = 120;    // default ~47% speed
const uint32_t MOTOR_PWM_FREQ  = 5000;
const uint8_t  MOTOR_PWM_BITS  = 8;
const int      MIN_SPEED_PCT   = 20;     // below this most motors just stall

// true  = wheels actively brake when stopped (holds the robot on a slope)
// false = wheels coast when stopped
const bool WHEEL_BRAKE = false;

// ============================================================
// ULTRASONIC RANGE SETTINGS
// ============================================================
// Air temperature changes the speed of sound (about 0.6 m/s per degree C).
const float AIR_TEMP_C       = 20.0f;
const float SOUND_CM_PER_US  = (331.3f + 0.606f * AIR_TEMP_C) / 10000.0f;

const float SONAR_MIN_CM     = 2.0f;
// HC-SR04 is rated for 400 cm. Accepting up to 450 cm lets the firmware use
// every echo the sensor can actually deliver on a good (flat, square-on) target.
const float SONAR_MAX_CM     = 450.0f;

// ============================================================
// AUTOMATIC MODE SETTINGS  (tune these on the bench; the detect range
// and sweep limits can also be changed live from the web page)
// ============================================================
const int   AUTO_SWEEP_MIN_DEG  = 0;
const int   AUTO_SWEEP_MAX_DEG  = 180;
const int   AUTO_SWEEP_STEP_DEG = 4;

const float AUTO_DETECT_CM = 150.0;  // objects closer than this are targets (was 50)
const float AUTO_REACH_CM  = 10.0;   // "arrived" distance -> stop and run conveyor

// 90 deg = straight ahead. If an object on the robot's LEFT shows up at a
// LOWER servo angle in your build, set this to false.
const bool  AUTO_ANGLE_HIGH_IS_LEFT = true;
// If the robot spins the wrong way toward the object, flip this.
const bool  AUTO_SWAP_TURN          = false;

// Turning is time-based (there is no heading sensor). CALIBRATE this:
// the serial monitor prints "turn LEFT 40 deg for 360 ms".
const unsigned long AUTO_TURN_MS_PER_DEG = 9;
const uint8_t       AUTO_TURN_PWM        = 150;
const float         AUTO_ALIGN_TOLERANCE_DEG = 8.0;

const unsigned long AUTO_CONVEYOR_MS          = 5000;
const unsigned long AUTO_BACKUP_MS            = 800;     // 0 = off
const unsigned long AUTO_APPROACH_TIMEOUT_MS  = 30000;   // longer: targets may now be further away
const uint8_t       AUTO_LOST_READINGS        = 5;
const bool          AUTO_REPEAT               = true;    // false = auto off after 1 collection

// Live-adjustable copies (changed from the web page)
float autoDetectCm  = AUTO_DETECT_CM;
int   autoSweepMin  = AUTO_SWEEP_MIN_DEG;
int   autoSweepMax  = AUTO_SWEEP_MAX_DEG;

struct Motor
{
    uint8_t in1, in2;
    uint8_t ch1, ch2;   // LEDC channels
    bool    reversed;
};

//                    IN1  IN2  ch1 ch2 reversed
Motor wheelLeft   = { 17,  5,   0,  1,  false };
Motor wheelRight  = { 18,  19,  2,  3,  false };
Motor conveyorA   = { 15,  25,  4,  5,  false };
Motor conveyorB   = { 4,   16,  6,  7,  false };

uint8_t driveSpeed    = BASE_PWM;
uint8_t conveyorSpeed = BASE_PWM;

uint8_t pctToPwm(int pct) { pct = constrain(pct, 0, 100); return (pct * 255 + 50) / 100; }
int     pwmToPct(uint8_t v) { return (v * 100 + 127) / 255; }

void motorInit(const Motor& m)
{
    pinMode(m.in1, OUTPUT);
    pinMode(m.in2, OUTPUT);
    pwmAttach(m.in1, m.ch1, MOTOR_PWM_FREQ, MOTOR_PWM_BITS);
    pwmAttach(m.in2, m.ch2, MOTOR_PWM_FREQ, MOTOR_PWM_BITS);
    pwmWrite(m.in1, m.ch1, 0);
    pwmWrite(m.in2, m.ch2, 0);
}

void motorStop(const Motor& m)    // coast
{
    pwmWrite(m.in1, m.ch1, 0);
    pwmWrite(m.in2, m.ch2, 0);
}

void motorBrake(const Motor& m)   // both inputs high = brake
{
    pwmWrite(m.in1, m.ch1, 255);
    pwmWrite(m.in2, m.ch2, 255);
}

void motorRun(const Motor& m, bool forward, uint8_t speed)
{
    if (m.reversed) forward = !forward;
    pwmWrite(m.in1, m.ch1, forward ? speed : 0);
    pwmWrite(m.in2, m.ch2, forward ? 0     : speed);
}

void wheelHalt(const Motor& m)
{
    if (WHEEL_BRAKE) motorBrake(m);
    else             motorStop(m);
}

// ============================================================
// DRIVE + CONVEYOR STATE
// ============================================================
const char* DRIVE_NAMES[]    = { "STOP", "FORWARD", "BACKWARD", "LEFT", "RIGHT",
                                  "SPIN LEFT", "SPIN RIGHT" };
const char* CONVEYOR_NAMES[] = { "STOP", "FORWARD", "REVERSE" };

DriveState    driveState    = DRIVE_STOP;
ConveyorState conveyorState = CONV_STOP;

unsigned long lastDriveCommand = 0;
const unsigned long DRIVE_TIMEOUT = 700;   // stop wheels if no command for 700 ms

// Fail-safe: if the controller page disappears, stop EVERYTHING
unsigned long lastClientContact = 0;
const unsigned long CLIENT_TIMEOUT = 3000;

void touchClient() { lastClientContact = millis(); }

void applyDrive()
{
    switch (driveState)
    {
        case DRIVE_FORWARD:
            motorRun(wheelLeft,  true,  driveSpeed);
            motorRun(wheelRight, true,  driveSpeed);
            break;
        case DRIVE_BACKWARD:
            motorRun(wheelLeft,  false, driveSpeed);
            motorRun(wheelRight, false, driveSpeed);
            break;
        case DRIVE_LEFT:               // turn left: RIGHT wheel drives, left wheel holds (pivot)
            wheelHalt(wheelLeft);
            motorRun(wheelRight, true, driveSpeed);
            break;
        case DRIVE_RIGHT:              // turn right: LEFT wheel drives, right wheel holds (pivot)
            motorRun(wheelLeft, true, driveSpeed);
            wheelHalt(wheelRight);
            break;
        case DRIVE_SPIN_LEFT:          // rotate counter-clockwise on the spot
            motorRun(wheelLeft,  false, AUTO_TURN_PWM);
            motorRun(wheelRight, true,  AUTO_TURN_PWM);
            break;
        case DRIVE_SPIN_RIGHT:         // rotate clockwise on the spot
            motorRun(wheelLeft,  true,  AUTO_TURN_PWM);
            motorRun(wheelRight, false, AUTO_TURN_PWM);
            break;
        default:
            wheelHalt(wheelLeft);
            wheelHalt(wheelRight);
            break;
    }
}

void setDrive(DriveState s)
{
    driveState = s;
    applyDrive();
    if (s != DRIVE_STOP) lastDriveCommand = millis();
}

void applyConveyor()
{
    switch (conveyorState)
    {
        case CONV_FORWARD:
            motorRun(conveyorA, true, conveyorSpeed);
            motorRun(conveyorB, true, conveyorSpeed);
            break;
        case CONV_REVERSE:
            motorRun(conveyorA, false, conveyorSpeed);
            motorRun(conveyorB, false, conveyorSpeed);
            break;
        default:
            motorStop(conveyorA);
            motorStop(conveyorB);
            break;
    }
}

void setConveyor(ConveyorState s)
{
    conveyorState = s;
    applyConveyor();
}

// ============================================================
// SERVO (direct LEDC, 50 Hz, 14 bit)
// ============================================================
const uint8_t  SERVO_CH   = 8;
const uint32_t SERVO_FREQ = 50;
const uint8_t  SERVO_BITS = 14;
int servoAngle = 90;

void servoWrite(int angle)
{
    angle = constrain(angle, 0, 180);
    uint32_t us   = map(angle, 0, 180, 500, 2400);          // pulse width in microseconds
    uint32_t duty = (us * (1UL << SERVO_BITS)) / 20000UL;   // 20 ms period
    pwmWrite(SERVO_PIN, SERVO_CH, duty);
    servoAngle = angle;
}

// Moves the servo and records when it should have arrived, so the
// ultrasonic readings taken while it was still moving can be ignored.
unsigned long servoReadyAt = 0;

void servoMoveTo(int angle)
{
    angle = constrain(angle, 0, 180);
    int delta = abs(angle - servoAngle);
    servoWrite(angle);
    servoReadyAt = millis() + 60 + (unsigned long)delta * 3;
}

// ============================================================
// BUZZER
// ============================================================
bool autoBuzzer   = true;
bool manualBuzzer = false;
bool buzzerState  = false;

unsigned long manualBuzzerUntil = 0;
unsigned long lastBeepChange    = 0;

const unsigned long BEEP_ON_TIME  = 100;
const unsigned long BEEP_OFF_TIME = 150;

void setBuzzer(bool on)
{
    digitalWrite(BUZZER_PIN, on ? HIGH : LOW);
    buzzerState = on;
}

// ============================================================
// ULTRASONIC (non-blocking: echo timed by an interrupt, no pulseIn)
// ============================================================
float distanceCM       = -1.0;   // raw reading (used by auto mode and the radar)
float distanceFiltered = -1.0;   // median of the last 3 (used for the big display)
bool  detected         = false;

const float         ALERT_DISTANCE_CM   = 10.0;
const float         ALERT_HYSTERESIS_CM = 2.0;
// 80 ms between pings lets long-range echoes die out before the next ping.
const unsigned long SONAR_INTERVAL      = 80;
// Round trip at 450 cm is ~26 ms; 35 ms gives margin (the HC-SR04 itself gives up at ~38 ms).
const unsigned long SONAR_TIMEOUT_MS    = 35;
const unsigned long SONAR_LOG_INTERVAL  = 1000;

volatile uint32_t echoStartUs    = 0;
volatile uint32_t echoDurationUs = 0;
volatile bool     echoStarted    = false;
volatile bool     echoDone       = false;

bool          sonarWaiting     = false;
unsigned long sonarTriggeredAt = 0;
unsigned long lastSonarRead    = 0;
unsigned long lastSonarLog     = 0;
uint8_t       closeCount       = 0;
int           pingAngle        = 90;   // servo angle when the ping was sent

uint32_t      readingSeq            = 0;   // increments on every completed reading
unsigned long lastReadingStartedAt  = 0;   // when that reading's ping was sent
int           lastReadingAngle      = 90;  // servo angle of that reading (for the radar)

float   medianBuf[3] = { -1, -1, -1 };
uint8_t medianIdx    = 0;

// Median of the last 3 readings: removes single-sample spikes and dropouts.
float median3(float d)
{
    medianBuf[medianIdx] = d;
    medianIdx = (medianIdx + 1) % 3;

    float v[3];
    for (int i = 0; i < 3; i++) v[i] = (medianBuf[i] < 0) ? 9999.0f : medianBuf[i];

    float t;
    if (v[0] > v[1]) { t = v[0]; v[0] = v[1]; v[1] = t; }
    if (v[1] > v[2]) { t = v[1]; v[1] = v[2]; v[2] = t; }
    if (v[0] > v[1]) { t = v[0]; v[0] = v[1]; v[1] = t; }

    return (v[1] >= 9999.0f) ? -1.0f : v[1];
}

void IRAM_ATTR echoISR()
{
    if (gpio_get_level((gpio_num_t)ECHO_PIN))
    {
        echoStartUs = micros();
        echoStarted = true;
    }
    else if (echoStarted)
    {
        echoDurationUs = micros() - echoStartUs;
        echoStarted = false;
        echoDone = true;
    }
}

bool objectDetected() { return detected; }

void processReading(float d)
{
    distanceCM = d;
    distanceFiltered = median3(d);
    lastReadingStartedAt = sonarTriggeredAt;
    lastReadingAngle = pingAngle;
    readingSeq++;

    // Need 2 close readings in a row to alarm, and a clear margin to release.
    if (d >= 0.0 && d <= ALERT_DISTANCE_CM)
    {
        if (closeCount < 255) closeCount++;
        if (closeCount >= 2) detected = true;
    }
    else if (d < 0.0 || d > ALERT_DISTANCE_CM + ALERT_HYSTERESIS_CM)
    {
        closeCount = 0;
        detected = false;
    }

    unsigned long now = millis();
    if (now - lastSonarLog >= SONAR_LOG_INTERVAL)
    {
        lastSonarLog = now;
        if (d >= 0.0) Serial.printf("Ultrasonic: %.1f cm\n", d);
        else          Serial.println("Ultrasonic: NO ECHO");
    }
}

void updateUltrasonic()
{
    unsigned long now = millis();

    if (sonarWaiting)
    {
        if (echoDone)
        {
            sonarWaiting = false;
            float d = (echoDurationUs * SOUND_CM_PER_US) / 2.0f;
            processReading((d >= SONAR_MIN_CM && d <= SONAR_MAX_CM) ? d : -1.0f);
        }
        else if (now - sonarTriggeredAt > SONAR_TIMEOUT_MS)
        {
            sonarWaiting = false;
            processReading(-1.0f);
        }
        return;
    }

    if (now - lastSonarRead < SONAR_INTERVAL) return;
    lastSonarRead = now;

    echoDone    = false;
    echoStarted = false;

    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);
    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN, LOW);

    sonarTriggeredAt = now;
    pingAngle = servoAngle;
    sonarWaiting = true;
}

// ============================================================
// LDR (averaged + hysteresis so it doesn't flicker)
// ============================================================
int  ldrValue = 0;
bool inSewer  = false;

const int LDR_DARK_BELOW  = 1400;   // below this -> in sewer (tune for your divider)
const int LDR_LIGHT_ABOVE = 1600;   // above this -> not in sewer
const unsigned long LDR_INTERVAL = 50;
unsigned long lastLdrRead = 0;

void updateLDR()
{
    unsigned long now = millis();
    if (now - lastLdrRead < LDR_INTERVAL) return;
    lastLdrRead = now;

    long sum = 0;
    for (int i = 0; i < 8; i++) sum += analogRead(LDR_PIN);
    ldrValue = sum / 8;

    if (ldrValue < LDR_DARK_BELOW)       inSewer = true;
    else if (ldrValue > LDR_LIGHT_ABOVE) inSewer = false;
}

// ============================================================
// BUZZER LOGIC
// ============================================================
void updateBuzzer()
{
    unsigned long now = millis();

    if (manualBuzzer)
    {
        if ((long)(manualBuzzerUntil - now) > 0)
        {
            setBuzzer(true);
            return;
        }
        manualBuzzer = false;
    }

    if (!autoBuzzer || !objectDetected())
    {
        setBuzzer(false);
        return;
    }

    unsigned long wait = buzzerState ? BEEP_ON_TIME : BEEP_OFF_TIME;
    if (now - lastBeepChange >= wait)
    {
        setBuzzer(!buzzerState);
        lastBeepChange = now;
    }
}

// ============================================================
// FAIL-SAFE
// ============================================================
void stopAll()
{
    setDrive(DRIVE_STOP);
    setConveyor(CONV_STOP);
}

// ============================================================
// AUTOMATIC MODE
// The sensor is mounted on the servo. The servo sweeps; when the
// sensor sees an object the robot turns toward it, drives up to it,
// runs the conveyor for AUTO_CONVEYOR_MS, backs off and scans again.
// ============================================================
const char* AUTO_NAMES[] = { "SCANNING", "TURNING", "APPROACHING", "COLLECTING", "BACKING UP" };

bool          autoMode       = false;
AutoState     autoState      = AUTO_SCAN;
unsigned long autoStateSince = 0;
uint32_t      autoLastSeq    = 0;
uint16_t      collectedCount = 0;

int     sweepAngle    = 90;
int     sweepDir      = 1;
bool    tracking      = false;
uint8_t hitConfirm    = 0;
uint8_t missCount     = 0;
int     firstHitAngle = 90;
int     lastHitAngle  = 90;
float   closestCm     = 0;

unsigned long turnUntil  = 0;
uint8_t       reachCount = 0;
uint8_t       lostCount  = 0;

void autoSetState(AutoState s)
{
    autoState = s;
    autoStateSince = millis();
}

// true once per NEW reading that was taken after the servo had settled
bool autoFreshReading()
{
    if (readingSeq == autoLastSeq) return false;
    autoLastSeq = readingSeq;
    return (long)(lastReadingStartedAt - servoReadyAt) >= 0;
}

void autoBeginScan()
{
    setDrive(DRIVE_STOP);
    setConveyor(CONV_STOP);
    tracking = false;
    hitConfirm = 0;
    missCount = 0;
    sweepAngle = autoSweepMin;
    sweepDir = 1;
    servoMoveTo(sweepAngle);
    autoLastSeq = readingSeq;
    autoSetState(AUTO_SCAN);
}

void autoEnable()
{
    stopAll();
    autoMode = true;
    Serial.println("AUTO: ON");
    autoBeginScan();
}

void autoDisable()
{
    if (autoMode)
    {
        autoMode = false;
        servoMoveTo(90);
        Serial.println("AUTO: OFF");
    }
    stopAll();
}

void autoStartApproach()
{
    reachCount = 0;
    lostCount = 0;
    unsigned long ready = millis() + 150;      // let the robot settle after turning
    if ((long)(servoReadyAt - ready) < 0) servoReadyAt = ready;
    autoLastSeq = readingSeq;
    autoSetState(AUTO_APPROACH);
}

void autoTargetFound()
{
    int   target = (firstHitAngle + lastHitAngle) / 2;   // middle of the object
    int   offset = target - 90;                          // + = toward higher servo angles
    int   mag    = abs(offset);
    bool  left   = AUTO_ANGLE_HIGH_IS_LEFT ? (offset > 0) : (offset < 0);

    Serial.printf("AUTO: object at %d deg, %.1f cm\n", target, closestCm);

    servoMoveTo(90);   // sensor now looks straight ahead

    if (mag <= AUTO_ALIGN_TOLERANCE_DEG)
    {
        autoStartApproach();
        return;
    }

    bool spinLeft = AUTO_SWAP_TURN ? !left : left;
    unsigned long ms = (unsigned long)mag * AUTO_TURN_MS_PER_DEG;
    Serial.printf("AUTO: turn %s %d deg for %lu ms\n", spinLeft ? "LEFT" : "RIGHT", mag, ms);

    setDrive(spinLeft ? DRIVE_SPIN_LEFT : DRIVE_SPIN_RIGHT);
    turnUntil = millis() + ms;
    autoSetState(AUTO_ALIGN);
}

void autoReached()
{
    setDrive(DRIVE_STOP);
    setConveyor(CONV_FORWARD);
    Serial.printf("AUTO: reached target, conveyor on for %lu ms\n", AUTO_CONVEYOR_MS);
    autoSetState(AUTO_COLLECT);
}

void autoUpdate()
{
    if (!autoMode) return;
    unsigned long now = millis();

    switch (autoState)
    {
        case AUTO_SCAN:
        {
            if (!autoFreshReading()) return;

            float d = distanceCM;
            bool hit = (d >= 0.0f && d <= autoDetectCm);
            bool finished = false;

            if (!tracking)
            {
                // need 2 hits in a row to believe it
                if (hit)
                {
                    if (hitConfirm == 0) { firstHitAngle = servoAngle; closestCm = d; }
                    if (d < closestCm) closestCm = d;
                    if (++hitConfirm >= 2)
                    {
                        tracking = true;
                        lastHitAngle = servoAngle;
                        missCount = 0;
                    }
                }
                else hitConfirm = 0;
            }
            else
            {
                // keep sweeping until the object ends, so we aim at its middle
                if (hit)
                {
                    lastHitAngle = servoAngle;
                    missCount = 0;
                    if (d < closestCm) closestCm = d;
                }
                else if (++missCount >= 2) finished = true;
            }

            bool atEnd = (servoAngle <= autoSweepMin || servoAngle >= autoSweepMax);
            if (finished || (tracking && atEnd))
            {
                autoTargetFound();
                return;
            }

            int next = sweepAngle + sweepDir * AUTO_SWEEP_STEP_DEG;
            if (next >= autoSweepMax)      { next = autoSweepMax; sweepDir = -1; }
            else if (next <= autoSweepMin) { next = autoSweepMin; sweepDir = 1;  }
            sweepAngle = next;
            servoMoveTo(sweepAngle);
            break;
        }

        case AUTO_ALIGN:
            if ((long)(now - turnUntil) >= 0)
            {
                setDrive(DRIVE_STOP);
                autoStartApproach();
            }
            break;

        case AUTO_APPROACH:
        {
            if (now - autoStateSince > AUTO_APPROACH_TIMEOUT_MS)
            {
                Serial.println("AUTO: approach timed out, rescanning");
                autoBeginScan();
                return;
            }
            if (!autoFreshReading()) return;

            float d = distanceCM;

            if (d >= 0.0f && d <= AUTO_REACH_CM)
            {
                if (++reachCount >= 2) { autoReached(); return; }
            }
            else reachCount = 0;

            bool visible = (d >= 0.0f && d <= autoDetectCm + 15.0f);
            if (visible)
            {
                lostCount = 0;
                if (driveState != DRIVE_FORWARD) setDrive(DRIVE_FORWARD);
            }
            else if (++lostCount >= AUTO_LOST_READINGS)
            {
                Serial.println("AUTO: lost the target, rescanning");
                autoBeginScan();
                return;
            }
            break;
        }

        case AUTO_COLLECT:
            if (now - autoStateSince >= AUTO_CONVEYOR_MS)
            {
                setConveyor(CONV_STOP);
                collectedCount++;
                Serial.printf("AUTO: done (%u collected)\n", (unsigned)collectedCount);

                if (!AUTO_REPEAT)           { autoDisable(); return; }
                if (AUTO_BACKUP_MS > 0)     { setDrive(DRIVE_BACKWARD); autoSetState(AUTO_BACKUP); }
                else                        autoBeginScan();
            }
            break;

        case AUTO_BACKUP:
            if (now - autoStateSince >= AUTO_BACKUP_MS)
            {
                setDrive(DRIVE_STOP);
                autoBeginScan();
            }
            break;
    }
}

// ============================================================
// STATUS JSON (no String concatenation -> no heap fragmentation)
// ============================================================
void fmtDist(char* out, size_t n, float d)
{
    if (d < 0) snprintf(out, n, "null");
    else       snprintf(out, n, "%.1f", d);
}

void handleStatus()
{
    touchClient();

    char dist[12], rdist[12];
    fmtDist(dist,  sizeof(dist),  distanceFiltered);
