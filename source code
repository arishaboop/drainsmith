        autoSweepMin,
        autoSweepMax,
        (int)SONAR_MAX_CM,
        AUTO_ANGLE_HIGH_IS_LEFT ? "true" : "false");

    if (n < 0 || n >= (int)sizeof(json))
    {
        server.send(500, "text/plain", "status too large");
        return;
    }

    server.sendHeader("Cache-Control", "no-store");
    server.send(200, "application/json", json);
}

