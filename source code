// ---------- RADAR ----------
const radar = {pts:[], range:200, angle:90, detect:150, hl:true};
const cv = $("radar"), ctx = cv.getContext("2d");
function fit(){
  const dpr = window.devicePixelRatio || 1, w = cv.clientWidth;
  cv.width = Math.round(w * dpr); cv.height = Math.round(w * 0.6 * dpr); cv.style.height = (w * 0.6) + "px";
}
window.addEventListener("resize", fit); fit();
document.querySelectorAll("[data-range]").forEach(b => b.addEventListener("click", () => {
  radar.range = +b.dataset.range;
  document.querySelectorAll("[data-range]").forEach(x => x.classList.toggle("sel", x === b));
  radar.pts = [];
}));
function draw(){
  const dpr = window.devicePixelRatio || 1, W = cv.width, H = cv.height, now = performance.now();
  ctx.clearRect(0, 0, W, H);
  const cx = W / 2, cy = H - 18 * dpr, R = Math.min(W / 2 - 14 * dpr, H - 34 * dpr);
  const th = a => (radar.hl ? a : 180 - a) * Math.PI / 180;
  const pol = (a, d) => [cx + d / radar.range * R * Math.cos(th(a)), cy - d / radar.range * R * Math.sin(th(a))];
  ctx.lineWidth = dpr; ctx.font = (10 * dpr) + "px ui-monospace,Menlo,monospace";
  // rings + labels
  for (let i = 1; i <= 4; i++){
    ctx.strokeStyle = "rgba(34,211,238,.2)"; ctx.beginPath(); ctx.arc(cx, cy, R * i / 4, Math.PI, 2 * Math.PI); ctx.stroke();
    ctx.fillStyle = "rgba(127,155,181,.85)"; ctx.fillText(Math.round(radar.range * i / 4) + " cm", cx + 4 * dpr, cy - R * i / 4 - 3 * dpr);
  }
  // spokes
  ctx.strokeStyle = "rgba(34,211,238,.12)";
  [0, 45, 90, 135, 180].forEach(a => { const p = pol(a, radar.range); ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(p[0], p[1]); ctx.stroke(); });
  // detect ring
  if (radar.detect <= radar.range){
    ctx.setLineDash([6 * dpr, 6 * dpr]); ctx.strokeStyle = "rgba(245,158,11,.7)";
    ctx.beginPath(); ctx.arc(cx, cy, radar.detect / radar.range * R, Math.PI, 2 * Math.PI); ctx.stroke(); ctx.setLineDash([]);
  }
  // sweep wedge + line
  const t = th(radar.angle);
  ctx.fillStyle = "rgba(34,211,238,.14)"; ctx.beginPath(); ctx.moveTo(cx, cy);
  ctx.arc(cx, cy, R, -(t + .09), -(t - .09)); ctx.closePath(); ctx.fill();
  ctx.strokeStyle = "rgba(103,232,249,.95)"; ctx.lineWidth = 2 * dpr; ctx.beginPath(); ctx.moveTo(cx, cy);
  const e = pol(radar.angle, radar.range); ctx.lineTo(e[0], e[1]); ctx.stroke();
  // echoes
  radar.pts = radar.pts.filter(p => now - p.t < 5000);
  radar.pts.forEach(p => {
    if (p.d > radar.range) return;
    const q = pol(p.a, p.d), al = 1 - (now - p.t) / 5000;
    ctx.fillStyle = (p.d <= 10 ? "rgba(239,68,68," : p.d <= radar.detect ? "rgba(245,158,11," : "rgba(52,211,153,") + al + ")";
    ctx.beginPath(); ctx.arc(q[0], q[1], 3.5 * dpr, 0, 6.3); ctx.fill();
  });
  // robot
  ctx.fillStyle = "#22d3ee"; ctx.beginPath(); ctx.moveTo(cx, cy - 10 * dpr); ctx.lineTo(cx + 8 * dpr, cy + 6 * dpr); ctx.lineTo(cx - 8 * dpr, cy + 6 * dpr); ctx.fill();
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);

// ---------- STATUS ----------
const DIR_BTN = {FORWARD:"forward", BACKWARD:"backward", LEFT:"left", RIGHT:"right"};
let prev = null, seqLast = -1, wasOnline = null;

function syncSlider(id, labelId, v){
  if (busy.has(id)) return;
  $(id).value = v; $(labelId).textContent = v; paint($(id));
}
function setTag(el, text, cls){ el.textContent = text; el.className = "tag" + (cls ? " " + cls : ""); }

function online(ok, ms){
  const l = $("link");
  l.className = "pill" + (ok ? "" : " off");
  l.querySelector("b").textContent = ok ? "CONNECTED" : "OFFLINE";
  l.querySelector("em").textContent = ok ? ms + " ms" : "";
  document.body.classList.toggle("offline", !ok);
  if (wasOnline !== null && wasOnline !== ok) log(ok ? "Connection restored" : "Connection lost", ok ? "good" : "bad");
  wasOnline = ok;
}

function render(d){
  // drive
  setTag($("driveState"), d.drive, d.drive === "STOP" ? "" : "ok");
  document.querySelectorAll("[data-dir]").forEach(b => b.classList.toggle("on", DIR_BTN[d.drive] === b.dataset.dir));

  // conveyor
  setTag($("conveyorState"), d.conveyor, d.conveyor === "STOP" ? "" : "ok");
  const g = $("gear");
  g.setAttribute("class", "gear" + (d.conveyor === "FORWARD" ? " f" : d.conveyor === "REVERSE" ? " r" : ""));
  g.style.animationDuration = (2.4 - d.convSpeed / 100 * 2) + "s";
  document.querySelectorAll("[data-conv]").forEach(b => b.classList.toggle("on", b.dataset.conv.toUpperCase() === d.conveyor));

  // auto
  autoOn = d.auto;
  document.body.classList.toggle("locked", autoOn);
  $("autoBtn").textContent = autoOn ? "■ STOP AUTO MODE" : "▶ START AUTO MODE";
  $("autoBtn").className = autoOn ? "stop" : "go";
  setTag($("autoTag"), autoOn ? d.autoState : "STANDBY", autoOn ? "ok" : "");
  document.querySelectorAll("#steps span").forEach(s => s.classList.toggle("act", autoOn && s.dataset.s === d.autoState));
  $("collected").textContent = d.collected;

  // sliders
  syncSlider("servo", "servoValue", d.servo);
  syncSlider("driveSpeed", "driveSpeedVal", d.driveSpeed);
  syncSlider("convSpeed", "convSpeedVal", d.convSpeed);
  syncSlider("detect", "detectVal", d.detectCm);
  syncSlider("swMin", "swMinVal", d.swMin);
  syncSlider("swMax", "swMaxVal", d.swMax);

  // radar + distance
  radar.angle = d.servo; radar.hl = d.highLeft; radar.detect = d.detectCm;
  if (d.seq !== seqLast){
    seqLast = d.seq;
    if (d.rDist !== null) radar.pts.push({a:d.rAngle, d:d.rDist, t:performance.now()});
    if (radar.pts.length > 400) radar.pts.shift();
  }
  if (d.distance === null){
    $("distance").textContent = "--"; $("meters").innerHTML = "&nbsp;"; $("proxBar").style.width = "0";
    setTag($("sonarTag"), "NO ECHO", "");
  } else {
    $("distance").textContent = Number(d.distance).toFixed(1);
    $("meters").textContent = (d.distance / 100).toFixed(2) + " m";
    $("proxBar").style.width = Math.max(3, 100 - Math.min(100, d.distance / d.maxCm * 100)) + "%";
    setTag($("sonarTag"), d.detected ? "⚠ OBJECT < 10 CM" : d.distance <= d.detectCm ? "OBJECT IN RANGE" : "AREA CLEAR",
           d.detected ? "bad" : d.distance <= d.detectCm ? "warn" : "ok");
  }

  // environment
  $("ldr").textContent = d.ldr;
  $("ldrMark").style.left = "calc(" + Math.min(100, d.ldr / 4095 * 100) + "% - 3px)";
  setTag($("sewerStatus"), d.inSewer ? "🌑 IN SEWER" : "☀️ NOT IN SEWER", d.inSewer ? "warn" : "ok");

  // buzzer
  setTag($("buzzerStatus"), d.buzzer ? "SOUNDING" : "OFF", d.buzzer ? "bad" : "");
  $("autoBuzzer").checked = d.autoBuzzer;

  // event log (state changes only)
  if (prev){
    if (d.drive !== prev.drive) log("Drive: " + d.drive);
    if (d.conveyor !== prev.conveyor) log("Conveyor: " + d.conveyor);
    if (d.auto !== prev.auto) log(d.auto ? "Auto mode started" : "Auto mode stopped", d.auto ? "good" : "warn");
    if (d.auto && d.autoState !== prev.autoState) log("Auto: " + d.autoState);
    if (d.collected > prev.collected) log("Object collected (#" + d.collected + ")", "good");
    if (d.detected && !prev.detected) log("Object within 10 cm", "bad");
    if (d.inSewer !== prev.inSewer) log(d.inSewer ? "Entered sewer (dark)" : "Left sewer (light)");
  } else log("Console connected", "good");
  prev = d;
}

async function poll(){
  const t0 = performance.now(), c = new AbortController(), to = setTimeout(() => c.abort(), 1500);
  try {
    const r = await fetch("/status", {cache:"no-store", signal:c.signal});
    const d = await r.json();
    online(true, Math.round(performance.now() - t0));
    render(d);
  } catch(e){ online(false); }
  finally { clearTimeout(to); setTimeout(poll, 250); }
}
poll();

