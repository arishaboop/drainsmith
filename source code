// ============================================================
// WEB HANDLERS
// ============================================================
void handleRoot()
{
    touchClient();
    server.send_P(200, "text/html", INDEX_HTML);
}

void handleMove()
{
    touchClient();
    String dir = server.arg("dir");

    // In auto mode manual driving is refused; a "stop" cancels auto mode.
    if (autoMode)
    {
        bool isMove = (dir == "forward" || dir == "backward" || dir == "left" || dir == "right");
        if (isMove)
        {
            server.send(409, "text/plain", "Auto mode is on");
            return;
        }
        autoDisable();
        server.send(200, "text/plain", "OK");
        return;
    }

    if      (dir == "forward")  setDrive(DRIVE_FORWARD);
    else if (dir == "backward") setDrive(DRIVE_BACKWARD);
    else if (dir == "left")     setDrive(DRIVE_LEFT);
    else if (dir == "right")    setDrive(DRIVE_RIGHT);
    else                        setDrive(DRIVE_STOP);

    server.send(200, "text/plain", "OK");
}

void handleConveyor()
{
    touchClient();
    if (autoMode)
    {
        server.send(409, "text/plain", "Auto mode is on");
        return;
    }

    String state = server.arg("state");

    if      (state == "forward") setConveyor(CONV_FORWARD);
    else if (state == "reverse") setConveyor(CONV_REVERSE);
    else                         setConveyor(CONV_STOP);

    server.send(200, "text/plain", "OK");
}

void handleSpeed()
{
    touchClient();
    if (!server.hasArg("target") || !server.hasArg("value"))
    {
        server.send(400, "text/plain", "Missing target/value");
        return;
    }

    int pct = constrain(server.arg("value").toInt(), MIN_SPEED_PCT, 100);
    String target = server.arg("target");

    if (target == "drive")
    {
        driveSpeed = pctToPwm(pct);
        applyDrive();
    }
    else if (target == "conveyor")
    {
        conveyorSpeed = pctToPwm(pct);
        applyConveyor();
    }
    else
    {
        server.send(400, "text/plain", "Bad target");
        return;
    }
    server.send(200, "text/plain", "OK");
}

void handleAuto()
{
    touchClient();
    if (!server.hasArg("state"))
    {
        server.send(400, "text/plain", "Missing state");
        return;
    }

    if (server.arg("state") == "1") { if (!autoMode) autoEnable(); }
    else                            autoDisable();

    server.send(200, "text/plain", "OK");
}

// Live tuning of auto mode: /auto-config?detect=150&min=0&max=180
void handleAutoConfig()
{
    touchClient();

    int mn = autoSweepMin;
    int mx = autoSweepMax;
    if (server.hasArg("min")) mn = constrain(server.arg("min").toInt(), 0, 160);
    if (server.hasArg("max")) mx = constrain(server.arg("max").toInt(), 20, 180);

    if (mx - mn < 20)
    {
        server.send(400, "text/plain", "Sweep range must be at least 20 degrees");
        return;
    }

    if (server.hasArg("detect"))
        autoDetectCm = constrain(server.arg("detect").toFloat(), 20.0f, SONAR_MAX_CM);

    autoSweepMin = mn;
    autoSweepMax = mx;
    server.send(200, "text/plain", "OK");
}

void handleServo()
{
    touchClient();
    if (!server.hasArg("angle"))
    {
        server.send(400, "text/plain", "Missing angle");
        return;
    }

    if (autoMode)
    {
        server.send(409, "text/plain", "Auto mode is on");
        return;
    }

    servoWrite(server.arg("angle").toInt());
    server.send(200, "text/plain", "OK");
}

void handleBuzzer()
{
    touchClient();
    if (server.hasArg("auto"))
    {
        autoBuzzer = server.arg("auto") == "1";
        if (!autoBuzzer && !manualBuzzer) setBuzzer(false);
        server.send(200, "text/plain", "OK");
    }
    else if (server.hasArg("test"))
    {
        manualBuzzer = true;
        manualBuzzerUntil = millis() + 300;
        setBuzzer(true);
        server.send(200, "text/plain", "OK");
    }
    else
    {
        server.send(400, "text/plain", "Invalid buzzer request");
    }
}

void handleMasterStop()
{
    touchClient();
    autoDisable();   // also stops everything
    manualBuzzer = false;
    setBuzzer(false);
    server.send(200, "text/plain", "MASTER STOP");
}

void handleFavicon()
{
    server.send(204, "text/plain", "");
}

void handleNotFound()
{
    server.send(404, "text/plain", "Not found: " + server.uri());
}

// ============================================================
// SETUP
// ============================================================
void setup()
{
    Serial.begin(115200);
    delay(500);

    // Motors (also sets them to a safe stopped state)
    motorInit(wheelLeft);
    motorInit(wheelRight);
    motorInit(conveyorA);
    motorInit(conveyorB);

    // Buzzer
    pinMode(BUZZER_PIN, OUTPUT);
    setBuzzer(false);

    // Ultrasonic
    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);
    digitalWrite(TRIG_PIN, LOW);
    attachInterrupt(digitalPinToInterrupt(ECHO_PIN), echoISR, CHANGE);

    // LDR
    pinMode(LDR_PIN, INPUT);
    analogReadResolution(12);

    // Servo
    pwmAttach(SERVO_PIN, SERVO_CH, SERVO_FREQ, SERVO_BITS);
    servoWrite(servoAngle);

    // WiFi access point
    WiFi.mode(WIFI_AP);
    WiFi.setSleep(false);   // lower latency
    if (!WiFi.softAP(WIFI_SSID, WIFI_PASSWORD, WIFI_CHANNEL, 0, WIFI_MAX_CLIENTS))
    {
        Serial.println("ERROR: failed to start access point");
    }

    // Web server routes
    server.on("/",            handleRoot);
    server.on("/move",        handleMove);
    server.on("/conveyor",    handleConveyor);
    server.on("/speed",       handleSpeed);
    server.on("/auto",        handleAuto);
    server.on("/auto-config", handleAutoConfig);
    server.on("/servo",       handleServo);
    server.on("/buzzer",      handleBuzzer);
    server.on("/status",      handleStatus);
    server.on("/master-stop", handleMasterStop);
    server.on("/favicon.ico", handleFavicon);
    server.onNotFound(handleNotFound);
    server.begin();

    lastClientContact = millis();

    Serial.println();
    Serial.println("==========================================");
    Serial.println("      SEWER CLEANING ROBOT - ESP32");
    Serial.println("==========================================");
    Serial.printf("WiFi: %s\n", WIFI_SSID);
    Serial.print("IP Address: ");
    Serial.println(WiFi.softAPIP());
    Serial.println("Web server: STARTED");
    Serial.println("==========================================");
}

// ============================================================
// LOOP
// ============================================================
void loop()
{
    server.handleClient();

    updateUltrasonic();
    updateLDR();
    updateBuzzer();
    autoUpdate();

    unsigned long now = millis();

    // Safety: stop wheels if the controller stops sending drive commands
    if (!autoMode && driveState != DRIVE_STOP && now - lastDriveCommand > DRIVE_TIMEOUT)
    {
        setDrive(DRIVE_STOP);
    }

    // Safety: no phone connected, or the page went silent -> stop everything
    bool somethingRunning = (driveState != DRIVE_STOP) || (conveyorState != CONV_STOP);
    bool clientLost = (WiFi.softAPgetStationNum() == 0 || now - lastClientContact > CLIENT_TIMEOUT);
    if (clientLost)
    {
        if (autoMode)               autoDisable();   // auto mode needs the page open
        else if (somethingRunning)  stopAll();
    }

    delay(1);
}
