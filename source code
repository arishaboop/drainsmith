        "\"detectCm\":%d,\"swMin\":%d,\"swMax\":%d,\"maxCm\":%d,\"highLeft\":%s}",
        DRIVE_NAMES[driveState],
        CONVEYOR_NAMES[conveyorState],
        servoAngle,
        dist,
        rdist,
        lastReadingAngle,
        (unsigned long)readingSeq,
        objectDetected() ? "true" : "false",
        autoBuzzer       ? "true" : "false",
        buzzerState      ? "true" : "false",
        ldrValue,
        inSewer          ? "true" : "false",
        pwmToPct(driveSpeed),
        pwmToPct(conveyorSpeed),
        autoMode ? "true" : "false",
        autoMode ? AUTO_NAMES[autoState] : "OFF",
        (unsigned)collectedCount,
